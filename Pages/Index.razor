@page "/"

<SfSchedule TValue="AppointmentDataModel" @bind-SelectedDate="@CurrentDate"
            FirstMonthOfYear="4" @bind-CurrentView="@CurrentView">
    <ScheduleEventSettings TValue="AppointmentDataModel" DataSource="@ScheduleData">
        <ScheduleViews>
            <ScheduleView Option="View.Day" Interval="3" DisplayName="3 Days"></ScheduleView>
            <ScheduleView Option="View.Week" Interval="2" DisplayName="2 Weeks"></ScheduleView>
            <ScheduleView Option="View.WorkWeek"></ScheduleView>
            <ScheduleView Option="View.Month"></ScheduleView>
            <ScheduleView Option="View.Year" IsSelected="true"></ScheduleView>
            <ScheduleView Option="View.TimelineDay"></ScheduleView>
            <ScheduleView Option="View.TimelineWeek"></ScheduleView>
            <ScheduleView Option="View.TimelineWorkWeek"></ScheduleView>
            <ScheduleView Option="View.TimelineMonth"></ScheduleView>
            <ScheduleView Option="View.TimelineYear" Orientation="Orientation.Vertical"></ScheduleView>
            <ScheduleView Option="View.Agenda"></ScheduleView>
            <ScheduleView Option="View.MonthAgenda"></ScheduleView>
        </ScheduleViews>
    </ScheduleEventSettings>

</SfSchedule>

@code {
    View CurrentView = View.Month;

    DateTime CurrentDate = new DateTime(2017, 6, 5);

    public class AppointmentDataModel
    {
        public int Id { get; set; }

        public string? Subject { get; set; }

        public DateTime StartTime { get; set; }

        public DateTime EndTime { get; set; }

        public bool IsAllDay { get; set; }

        public string? RecurrenceRule { get; set; }
    }

    List<AppointmentDataModel> ScheduleData = new List<AppointmentDataModel>
    {
        new AppointmentDataModel { Id = 1, Subject = "Budget Review", StartTime = new DateTime(2017, 6, 1, 9, 0, 0), EndTime = new DateTime(2017, 6, 1, 10, 30, 0) },
        new AppointmentDataModel { Id = 2, Subject = "Design Review", StartTime = new DateTime(2017, 6, 2, 11, 0, 0), EndTime = new DateTime(2017, 6, 2, 12, 30, 0) },
        new AppointmentDataModel { Id = 3, Subject = "Stand-up Meeting", StartTime = new DateTime(2017, 6, 5, 9, 30, 0), EndTime = new DateTime(2017, 6, 5, 10, 0, 0), RecurrenceRule = "FREQ=DAILY;INTERVAL=1;COUNT=5" },
        new AppointmentDataModel { Id = 4, Subject = "Sprint Planning", StartTime = new DateTime(2017, 6, 6, 14, 0, 0), EndTime = new DateTime(2017, 6, 6, 16, 0, 0) },
        new AppointmentDataModel { Id = 5, Subject = "Client Call", StartTime = new DateTime(2017, 6, 7, 10, 30, 0), EndTime = new DateTime(2017, 6, 7, 11, 30, 0) },
        new AppointmentDataModel { Id = 6, Subject = "Team Outing", StartTime = new DateTime(2017, 6, 8, 0, 0, 0), EndTime = new DateTime(2017, 6, 9, 0, 0, 0), IsAllDay = true },
        new AppointmentDataModel { Id = 7, Subject = "Regression Testing", StartTime = new DateTime(2017, 6, 12, 13, 0, 0), EndTime = new DateTime(2017, 6, 12, 17, 0, 0) },
        new AppointmentDataModel { Id = 8, Subject = "Release Meeting", StartTime = new DateTime(2017, 6, 14, 15, 30, 0), EndTime = new DateTime(2017, 6, 14, 16, 30, 0) },
        new AppointmentDataModel { Id = 9, Subject = "Product Demo", StartTime = new DateTime(2017, 6, 15, 11, 0, 0), EndTime = new DateTime(2017, 6, 15, 12, 0, 0) },
        new AppointmentDataModel { Id = 10, Subject = "Retrospective", StartTime = new DateTime(2017, 6, 16, 16, 0, 0), EndTime = new DateTime(2017, 6, 16, 17, 0, 0) },
    };
}